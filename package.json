{
  "name": "json2emap",
  "version": "1.0.0",
  "description": "Convert JSON to Emap, a format that is easy to parse in Resonite.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "jest",
    "test:dist": "node scripts/smoke-test.cjs && node scripts/smoke-test.mjs && tsc -p scripts/tsconfig.smoke.json",
    "typecheck": "tsc -p tsconfig.json",
    "fix:format": "prettier --write \"**/*.{js,cjs,mjs,ts,cts,mts,json,md,yml}\"",
    "check:format": "prettier --check \"**/*.{js,cjs,mjs,ts,cts,mts,json,md,yml}\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:dist"
  },
  "devDependencies": {
    "@edge-runtime/jest-environment": "^2.3.10",
    "@types/jest": "29.1.2",
    "@types/node": "^17.0.17",
    "jest": "29.1.2",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rheniumNV/json2emap.git"
  },
  "keywords": [
    "resonite",
    "neos",
    "neosvr",
    "emap"
  ],
  "author": "rhenium_nv",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rheniumNV/json2emap/issues"
  },
  "homepage": "https://github.com/rheniumNV/json2emap#readme",
  "volta": {
    "node": "20.12.2"
  }
}
